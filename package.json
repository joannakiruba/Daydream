{
  "name": "daydream",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "vite & sleep 2 && electron .",
    "electron:build": "tsc -b && vite build && electron-builder --config electron-builder.json",
    "electron:build:win": "tsc -b && vite build && electron-builder --win --config electron-builder.json",
    "electron:build:mac": "tsc -b && vite build && electron-builder --mac --config electron-builder.json",
    "electron:build:linux": "tsc -b && vite build && electron-builder --linux --config electron-builder.json"
  },
  "dependencies": {
    "framer-motion": "^14.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
